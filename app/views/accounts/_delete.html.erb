<section id="delete" class="mt-10 flex flex-col gap-4 border-t border-base-300 pt-6">
  <h2 class="text-lg font-semibold">Delete account</h2>
  <p class="text-sm opacity-70">
    This permanently deletes your account, profile picture, comments, likes and saved posts.
    It cannot be undone.
  </p>
  <%= form_with url: account_path, method: :delete, class: "flex flex-col gap-3",
        data: { turbo_confirm: "Delete your account permanently?" } do |f| %>
    <%= f.label :confirm_username, "Type your username (#{user.username}) to confirm", class: "text-sm" %>
    <%= f.text_field :confirm_username, required: true, autocomplete: "off",
          placeholder: "Username", "aria-label": "Confirm username",
          class: "input input-bordered w-full" %>
    <%= f.submit "Delete my account", class: "btn btn-error" %>
  <% end %>
</section>