<div id="<%= dom_id card %>" class="custom-card w-full max-w-sm" style="border: 1px solid #ddd; border-radius: 8px; overflow: hidden; background: #fff; margin-bottom: 20px;">
  <% if card.image.attached? %>
    <!-- Fixed typo 'ssize-64' to 'size-64', added mx-auto to center it if it's smaller than the card -->
    <%= image_tag card.image, class: "size-64 object-contain mx-auto" %>
  <% else %>
    <!-- Matches the 256px (size-64) height of the image above for visual consistency -->
    <div style="width: 100%; height: 256px; background: #f0f0f0; display: flex; align-items: center; justify-content: center; color: #888;">No Image</div>
  <% end %>
  <div style="padding: 12px;">
    <h4 style="margin: 0 0 10px 0;"><%= card.title %></h4>
    <p class="text-sm text-base-content/60">
      Created <%= card.created_at.strftime("%d %b %Y") %>
    </p>
    <p class="text-xs text-base-content/50 mt-1">
      Updated <%= card.updated_at.strftime("%d %b %Y") %>
    </p>
  </div>
</div>
