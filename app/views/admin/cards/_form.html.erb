<%= form_with(model: admin_card, class: "contents") do |form| %>
  <% if admin_card.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(admin_card.errors.count, "error") %> prohibited this admin_card from being saved:</h2>

      <ul class="list-disc ml-6">
        <% admin_card.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Drop down to select topics %>

  <div class="my-5">
    <%= form.label :topic %>
    <%= form.collection_select :topic_id,
        @topics,
        :id,
        :title,
        { prompt: "Select a topic" },
        class: "select select-bordered w-full" %>
  </div>

  <div class="my-5 flex flex-col">
    <%= form.label :image, "Upload Card Image", class:"bg-red-400" %>
    <%= form.file_field :image, direct_upload: true, required: true %>
    <%= form.label :title, class:"font-bold text-2xl" %>
    <%= form.text_field :title, required: true, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": admin_card.errors[:title].none?, "border-red-400 focus:outline-red-600": admin_card.errors[:title].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
