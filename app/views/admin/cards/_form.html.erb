<%= form_with(model: admin_card, class: "contents") do |form| %>
  <div class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body space-y-4">
      <% if admin_card.errors.any? %>
        <div role="alert" class="alert alert-error alert-soft">
          <div>
            <p class="font-semibold"><%= pluralize(admin_card.errors.count, "error") %> prevented this card from being saved:</p>
            <ul class="list-disc ml-5 text-sm">
              <% admin_card.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
      <div class="flex flex-col gap-2">
        <%= form.label :topic_id, "Topic", class: "font-semibold" %>
        <%= form.collection_select :topic_id, @topics, :id, :title, { prompt: "Select a topic" }, required: true, class: ["select select-bordered w-full", { "select-error": admin_card.errors[:topic].any? }] %>
      </div>
      <div class="flex flex-col gap-2">
        <%= form.label :title, class: "font-semibold" %>
        <%= form.text_field :title, required: true, placeholder: "Card title", class: ["input input-bordered w-full", { "input-error": admin_card.errors[:title].any? || admin_card.errors[:slug].any? }] %>
        <div id="slug-availability" class="text-sm"></div>
      </div>
      <div class="flex flex-col gap-2">
        <%= form.label :image, class: "font-semibold" %>
        <% if admin_card.persisted? && admin_card.image.attachment&.persisted? %>
          <div class="flex items-center gap-3">
            <%= image_tag admin_card.image.variant(:card), class: "w-24 h-16 object-cover rounded-md" %>
            <span class="text-sm text-base-content/60">Current image. Choosing a new one will replace it.</span>
          </div>
        <% end %>
        <%= form.file_field :image, direct_upload: true, accept: "image/jpeg,image/png,image/webp", required: !admin_card.image.attached?, class: ["file-input file-input-bordered w-full", { "file-input-error": admin_card.errors[:image].any? }] %>
        <p class="text-xs text-base-content/50">JPEG, PNG or WebP, up to 5 MB.</p>
      </div>
      <div class="card-actions justify-end pt-2">
        <%= link_to "Cancel", admin_cards_path, class: "btn btn-ghost" %>
        <%= form.submit class: "btn btn-primary" %>
      </div>
    </div>
  </div>
<% end %>