<% content_for :title, "Cards" %>
<div class="max-w-5xl mx-auto mt-12 px-4">
  <% if notice.present? %>
    <div role="alert" class="notice notice--success mb-6">
      <span><%= notice %></span>
    </div>
  <% end %>
  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-3xl font-bold">Cards</h1>
      <p class="text-sm text-base-content/60">
        <%= pluralize(@topics.sum { |t| t.cards.size }, "card") %> in <%= pluralize(@topics.size, "topic") %>
      </p>
    </div>
    <%= link_to "New card", new_admin_card_path, class: "btn btn-primary" %>
  </div>
  <% if @topics.any? %>
    <div class="space-y-8">
      <% @topics.each do |topic| %>
        <section>
          <%# Topic header %>
          <div class="flex items-center gap-3 mb-3">
            <% if topic.image.attached? %>
              <%= image_tag topic.image.variant(:card), class: "w-12 h-12 object-cover rounded-lg" %>
            <% end %>
            <h2 class="text-xl font-bold"><%= topic.title %></h2>
            <span class="badge badge-ghost"><%= pluralize(topic.cards.size, "card") %></span>
            <%= link_to "Edit topic", edit_admin_topic_path(topic), class: "btn btn-xs btn-ghost ml-auto" %>
          </div>
          <%# Cards under this topic %>
          <div class="ml-6 pl-4 border-l-2 border-base-300 space-y-2">
            <% if topic.cards.any? %>
              <% topic.cards.sort_by { |c| c.title.to_s.downcase }.each do |card| %>
                <div class="flex items-center justify-between gap-3 rounded-box border border-base-300 bg-base-100 p-3 hover:bg-base-200/50">
                  <div class="flex items-center gap-3 min-w-0">
                    <% if card.image.attached? %>
                      <%= image_tag card.image.variant(:card), class: "w-16 h-12 object-cover rounded-md shrink-0" %>
                    <% else %>
                      <div class="w-16 h-12 rounded-md bg-base-200 flex items-center justify-center text-xs text-base-content/40 shrink-0">No image</div>
                    <% end %>
                    <div class="min-w-0">
                      <div class="font-semibold truncate"><%= card.title %></div>
                      <div class="text-xs text-base-content/50">
                        <%= card.slug %> · <%= card.created_at.strftime("%d %b %Y") %>
                      </div>
                    </div>
                  </div>
                  <div class="flex gap-2 shrink-0">
                    <%= link_to "View", admin_card_path(card), class: "btn btn-sm btn-ghost" %>
                    <%= link_to "Edit", edit_admin_card_path(card), class: "btn btn-sm btn-outline" %>
                    <%= button_to "Delete", admin_card_path(card), method: :delete,
                          class: "btn btn-sm btn-error btn-outline",
                          data: { turbo_confirm: "Card and posts will be deleted. Sure?" } %>
                  </div>
                </div>
              <% end %>
            <% else %>
              <p class="text-sm text-base-content/50 italic py-2">No card in topic.</p>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 text-base-content/60">
      <p class="mb-4">No Topic, create one first.</p>
      <%= link_to "New topic", new_admin_topic_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>