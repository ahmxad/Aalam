<% content_for :title, @admin_card.title %>
<div class="max-w-4xl mx-auto mt-12 px-4">
  <% if notice.present? %>
    <div role="alert" class="alert alert-success mb-6">
      <span><%= notice %></span>
    </div>
  <% end %>
  <div class="breadcrumbs text-sm mb-4">
    <ul>
      <li><%= link_to "Cards", admin_cards_path %></li>
      <% if @admin_card.topic %>
        <li><%= link_to @admin_card.topic.title, admin_topic_path(@admin_card.topic) %></li>
      <% end %>
      <li><%= @admin_card.title %></li>
    </ul>
  </div>
  <div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden">
    <% if @admin_card.image.attached? %>
      <figure>
        <%= image_tag @admin_card.image.variant(:card), class: "w-full h-56 object-cover" %>
      </figure>
    <% end %>
    <div class="card-body">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h1 class="text-3xl font-bold"><%= @admin_card.title %></h1>
          <% if @admin_card.topic %>
            <p class="text-sm text-base-content/50 mt-1">
              /topics/<%= @admin_card.topic.slug %>/<%= @admin_card.slug %>
            </p>
          <% end %>
        </div>
        <% if @admin_card.topic %>
          <%= link_to "View on site",
                topic_card_path(@admin_card.topic.slug, @admin_card.slug),
                class: "btn btn-sm btn-outline",
                target: "_blank",
                rel: "noopener" %>
        <% end %>
      </div>
      <p class="text-sm text-base-content/60">
        Created <%= @admin_card.created_at.strftime("%d %b %Y") %> ·
        Updated <%= @admin_card.updated_at.strftime("%d %b %Y") %>
      </p>
      <div class="card-actions justify-end mt-4">
        <%= link_to "Back", admin_cards_path, class: "btn btn-ghost" %>
        <%= link_to "Edit", edit_admin_card_path(@admin_card), class: "btn btn-outline" %>
        <%= button_to "Delete", admin_card_path(@admin_card), method: :delete,
              class: "btn btn-error btn-outline",
              data: { turbo_confirm: "This will delete the card and all of its posts. Are you sure?" } %>
      </div>
    </div>
  </div>
  <div class="mt-10">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-xl font-bold">Posts <span class="badge badge-ghost"><%= @posts.size %></span></h2>
      <%= link_to "New post", new_admin_post_path, class: "btn btn-sm btn-primary" %>
    </div>
    <% if @posts.any? %>
      <div class="space-y-2">
        <% @posts.each do |post| %>
          <%= link_to admin_post_path(post), class: "block rounded-box border border-base-300 bg-base-100 p-3 hover:bg-base-200/50" do %>
            <div class="font-semibold"><%= post.title %></div>
            <div class="text-sm text-base-content/60 truncate"><%= truncate(post.summary, length: 120) %></div>
            <div class="text-xs text-base-content/40 mt-1"><%= post.created_at.strftime("%d %b %Y") %></div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-base-content/50 italic">No posts in this card yet.</p>
    <% end %>
  </div>
</div>