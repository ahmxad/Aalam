<%= form_with(model: admin_post, class: "contents") do |form| %>
  <div class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body space-y-4">
      <% if admin_post.errors.any? %>
        <div role="alert" class="alert alert-error alert-soft">
          <div>
            <p class="font-semibold"><%= pluralize(admin_post.errors.count, "error") %> prevented this post from being saved:</p>
            <ul class="list-disc ml-5 text-sm">
              <% admin_post.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>
      <div class="flex flex-col gap-2">
        <%= form.label :card_id, "Card", class: "font-semibold" %>
        <%= form.grouped_collection_select :card_id, @topics, :cards, :title, :id, :title, { prompt: "Select a card" }, required: true, class: ["select select-bordered w-full", { "select-error": admin_post.errors[:card].any? }] %>
      </div>
      <div class="flex flex-col gap-2">
        <%= form.label :title, class: "font-semibold" %>
        <%= form.text_field :title, required: true, placeholder: "Post title", class: ["input input-bordered w-full", { "input-error": admin_post.errors[:title].any? || admin_post.errors[:slug].any? }] %>
        <div id="post-slug-availability" class="text-sm"></div>
      </div>
      <div class="flex flex-col gap-2">
        <%= form.label :summary, class: "font-semibold" %>
        <%= form.text_field :summary, required: true, placeholder: "A short description shown in lists and search results", class: ["input input-bordered w-full", { "input-error": admin_post.errors[:summary].any? }] %>
      </div>
      <div class="flex flex-col gap-2">
        <%= form.label :body, class: "font-semibold" %>
        <%= form.textarea :body, required: true, rows: 10, placeholder: "Write the post content here", class: ["textarea textarea-bordered w-full", { "textarea-error": admin_post.errors[:body].any? }] %>
      </div>
      <div class="card-actions justify-end pt-2">
        <%= link_to "Cancel", admin_posts_path, class: "btn btn-ghost" %>
        <%= form.submit class: "btn btn-primary" %>
      </div>
    </div>
  </div>
<% end %>