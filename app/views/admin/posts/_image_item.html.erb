<li class="flex items-center gap-3 border border-base-300 bg-base-200 p-2"
    data-blob-id="<%= blob_id %>" data-filename="<%= filename %>">
  <%= hidden_field_tag "admin_post[images][]", signed_id, id: nil %>
  <img src="<%= thumb_url %>" alt="" class="h-14 w-20 shrink-0 bg-base-300 object-cover">

  <div class="min-w-0 flex-1">
    <p class="truncate text-sm font-semibold" data-role="name"><%= filename %></p>
    <p class="text-xs text-base-content/60" data-role="status"></p>
  </div>

  <div class="flex shrink-0 gap-2">
    <button type="button" class="btn btn-sm btn-primary" data-action="post-images#insert">Insert</button>
    <button type="button" class="btn btn-sm btn-ghost" data-action="post-images#remove">Remove</button>
  </div>
</li>