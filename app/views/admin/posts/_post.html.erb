<div id="<%= dom_id post %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-bold mb-1 text-2xl">Title:</strong>
    <%= post.title %>
    <p class="text-sm text-base-content/60 mt-2">
      Created <%= post.created_at.strftime("%d %b %Y") %>
    </p>
    <p class="text-xs text-base-content/50 mt-1">
      Updated <%= post.updated_at.strftime("%d %b %Y") %>
    </p>
  </div>
  <div>
    <strong class="block font-bold mb-1 text-2xl">Summary:</strong>
    <%= post.summary %>
  </div>
  <div>
    <strong class="block font-bold mb-1 text-2xl">Body:</strong>
    <%= post.body %>
  </div>
</div>
