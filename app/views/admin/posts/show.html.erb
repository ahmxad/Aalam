<% content_for :title, @admin_post.title %>
<% card = @admin_post.card %>
<% topic = card.topic %>
<div class="max-w-4xl mx-auto mt-12 px-4">
  <% if notice.present? %>
    <div role="alert" class="alert alert-success mb-6">
      <span><%= notice %></span>
    </div>
  <% end %>
  <div class="breadcrumbs text-sm mb-4">
    <ul>
      <li><%= link_to "Posts", admin_posts_path %></li>
      <% if topic %>
        <li><%= link_to topic.title, admin_topic_path(topic) %></li>
      <% end %>
      <li><%= link_to card.title, admin_card_path(card) %></li>
      <li><%= @admin_post.title %></li>
    </ul>
  </div>
  <div class="card bg-base-100 border border-base-300 shadow-sm">
    <div class="card-body">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h1 class="text-3xl font-bold"><%= @admin_post.title %></h1>
          <% if topic %>
            <p class="text-sm text-base-content/50 mt-1">
              /topics/<%= topic.slug %>/<%= card.slug %>/<%= @admin_post.slug %>
            </p>
          <% end %>
        </div>
        <% if topic %>
          <%= link_to "View on site",
                topic_card_post_path(topic.slug, card.slug, @admin_post.slug),
                class: "btn btn-sm btn-outline",
                target: "_blank",
                rel: "noopener" %>
        <% end %>
      </div>
      <p class="text-sm text-base-content/60">
        Created <%= @admin_post.created_at.strftime("%d %b %Y") %> ·
        Updated <%= @admin_post.updated_at.strftime("%d %b %Y") %>
      </p>
      <div class="divider my-2"></div>
      <div>
        <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/50 mb-1">Summary</h2>
        <p><%= @admin_post.summary %></p>
      </div>
      <div class="mt-4">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-base-content/50 mb-1">Body</h2>
        <div class="whitespace-pre-line"><%= @admin_post.body %></div>
      </div>
      <div class="card-actions justify-end mt-6">
        <%= link_to "Back", admin_posts_path, class: "btn btn-ghost" %>
        <%= link_to "Edit", edit_admin_post_path(@admin_post), class: "btn btn-outline" %>
        <%= button_to "Delete", admin_post_path(@admin_post), method: :delete,
              class: "btn btn-error btn-outline",
              data: { turbo_confirm: "This will delete the post. Are you sure?" } %>
      </div>
    </div>
  </div>
</div>