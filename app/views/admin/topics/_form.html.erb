<%= form_with(model: admin_topic, class: "contents") do |form| %>
  <div class="surface-panel">
    <div class="surface-panel__body space-y-4">

      <% if admin_topic.errors.any? %>
        <div role="alert" class="notice notice--error">
          <div>
            <p class="font-semibold"><%= pluralize(admin_topic.errors.count, "error") %> prevented this topic from being saved:</p>
            <ul class="list-disc ml-5 text-sm">
              <% admin_topic.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        </div>
      <% end %>

      <div class="flex flex-col gap-2">
        <%= form.label :title, class: "font-semibold" %>
        <%= form.text_field :title, required: true, autofocus: true, placeholder: "Topic title", class: ["input input-bordered w-full", { "input-error": admin_topic.errors[:title].any? || admin_topic.errors[:slug].any? }] %>
        <div id="slug-availability" class="text-sm"></div>
      </div>

      <div class="flex flex-col gap-2">
        <%= form.label :image, class: "font-semibold" %>

        <% if admin_topic.persisted? && admin_topic.image.attachment&.persisted? %>
          <div class="flex items-center gap-3">
            <%= image_tag admin_topic.image.variant(:card), class: "w-24 h-16 object-cover rounded-md" %>
            <span class="text-sm text-base-content/60">Current image. Choosing a new one will replace it.</span>
          </div>
        <% end %>

        <%= form.file_field :image, accept: "image/jpeg,image/png,image/webp", required: !admin_topic.image.attached?, class: ["file-input file-input-bordered w-full", { "file-input-error": admin_topic.errors[:image].any? }] %>
        <p class="text-xs text-base-content/50">JPEG, PNG or WebP, up to 5 MB.</p>
      </div>

      <div class="card-actions justify-end pt-2">
        <%= link_to "Cancel", admin_topics_path, class: "btn btn-ghost" %>
        <%= form.submit class: "btn btn-primary" %>
      </div>

    </div>
  </div>
<% end %>