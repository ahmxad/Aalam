<div id="<%= dom_id topic %>" class="w-full sm:w-auto my-5 space-y-5 mt-12 mb-12">

  <% if topic.image.attached? %>
    <%= image_tag topic.image, class: "w-64 h-40 object-cover rounded-lg" %>
  <% end %>

  <div>
    <strong class="block font-medium mb-1">Title:</strong>
    <%= topic.title %>
  </div>

  <div class="text-sm text-base-content/60">
  Created <%= topic.created_at.strftime("%d %b %Y") %>
</div>

<div class="text-xs text-base-content/50">
  Updated <%= topic.updated_at.strftime("%d %b %Y") %>
</div>

</div>