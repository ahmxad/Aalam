<% content_for :title, "Topics" %>
<div class="max-w-5xl mx-auto mt-12 px-4">
  <% if notice.present? %>
    <div role="alert" class="notice notice--success mb-6">
      <span><%= notice %></span>
    </div>
  <% end %>
  <div class="flex justify-between items-center mb-6">
    <div>
      <h1 class="text-3xl font-bold">Topics</h1>
      <p class="text-sm text-base-content/60"><%= pluralize(@admin_topics.size, "topic") %></p>
    </div>
    <%= link_to "New topic", new_admin_topic_path, class: "btn btn-primary" %>
  </div>
  <% if @admin_topics.any? %>
    <div class="overflow-x-auto rounded-box border border-base-300">
      <table class="table">
        <thead>
          <tr>
            <th>Topic</th>
            <th>Created</th>
            <th class="text-right">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @admin_topics.each do |topic| %>
            <tr class="hover">
              <td>
                <div class="flex items-center gap-3">
                  <% if topic.image.attached? %>
                    <%= image_tag topic.image.variant(:card), class: "w-16 h-12 object-cover rounded-md" %>
                  <% end %>
                  <div>
                    <div class="font-semibold"><%= topic.title %></div>
                    <div class="text-xs text-base-content/50"><%= topic.slug %></div>
                  </div>
                </div>
              </td>
              <td class="text-sm"><%= topic.created_at.strftime("%d %b %Y") %></td>
              <td>
                <div class="flex justify-end gap-2">
                  <%= link_to "View", admin_topic_path(topic), class: "btn btn-sm btn-ghost" %>
                  <%= link_to "Edit", edit_admin_topic_path(topic), class: "btn btn-sm btn-outline" %>
                  <%= button_to "Delete", admin_topic_path(topic), method: :delete,
                        class: "btn btn-sm btn-error btn-outline",
                        data: { turbo_confirm: "Ye topic, uske saare cards aur posts delete ho jayenge. Pakka?" } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="text-center py-16 text-base-content/60">
      <p class="mb-4">No topics yet.</p>
      <%= link_to "Create First topic", new_admin_topic_path, class: "btn btn-primary" %>
    </div>
  <% end %>
</div>