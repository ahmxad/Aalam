<% content_for :title, @admin_topic.title %>
<div class="max-w-4xl mx-auto mt-12 px-4">
  <% if notice.present? %>
    <div role="alert" class="alert alert-success mb-6">
      <span><%= notice %></span>
    </div>
  <% end %>
  <div class="breadcrumbs text-sm mb-4">
    <ul>
      <li><%= link_to "Topics", admin_topics_path %></li>
      <li><%= @admin_topic.title %></li>
    </ul>
  </div>
  <div class="card bg-base-100 border border-base-300 shadow-sm overflow-hidden">
    <% if @admin_topic.image.attached? %>
      <figure>
        <%= image_tag @admin_topic.image.variant(:card), class: "w-full h-56 object-cover" %>
      </figure>
    <% end %>
    <div class="card-body">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h1 class="text-3xl font-bold"><%= @admin_topic.title %></h1>
          <p class="text-sm text-base-content/50 mt-1">/topics/<%= @admin_topic.slug %></p>
        </div>
        <%= link_to "View on site", topic_path(@admin_topic), class: "btn btn-sm btn-outline", target: "_blank", rel: "noopener" %>
      </div>
      <p class="text-sm text-base-content/60">
        Created <%= @admin_topic.created_at.strftime("%d %b %Y") %> ·
        Updated <%= @admin_topic.updated_at.strftime("%d %b %Y") %>
      </p>
      <div class="card-actions justify-end mt-4">
        <%= link_to "Back", admin_topics_path, class: "btn btn-ghost" %>
        <%= link_to "Edit", edit_admin_topic_path(@admin_topic), class: "btn btn-outline" %>
        <%= button_to "Delete", admin_topic_path(@admin_topic), method: :delete,
              class: "btn btn-error btn-outline",
              data: { turbo_confirm: "This will delete the topic and all of its cards and posts. Are you sure?" } %>
      </div>
    </div>
  </div>
  <div class="mt-10">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-xl font-bold">Cards <span class="badge badge-ghost"><%= @cards.size %></span></h2>
      <%= link_to "New card", new_admin_card_path, class: "btn btn-sm btn-primary" %>
    </div>
    <% if @cards.any? %>
      <div class="space-y-2">
        <% @cards.each do |card| %>
          <%= link_to admin_card_path(card), class: "flex items-center gap-3 rounded-box border border-base-300 bg-base-100 p-3 hover:bg-base-200/50" do %>
            <% if card.image.attached? %>
              <%= image_tag card.image.variant(:card), class: "w-16 h-12 object-cover rounded-md shrink-0" %>
            <% else %>
              <div class="w-16 h-12 rounded-md bg-base-200 shrink-0"></div>
            <% end %>
            <span class="font-semibold"><%= card.title %></span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-base-content/50 italic">No cards in this topic yet.</p>
    <% end %>
  </div>
</div>