<li id="<%= dom_id(comment) %>" class="flex gap-3">
  <%# Links to profiles leave the window and open as a normal page %>
  <%= link_to profile_path(comment.user.username), data: { turbo_frame: "_top" }, class: "shrink-0",
        aria: { label: "#{comment.user.public_name} profile" } do %>
    <%= user_avatar(comment.user, size_class: "w-8", letter_class: "text-sm") %>
  <% end %>
  <div class="min-w-0 flex-1">
    <p class="text-sm">
      <%= link_to comment.user.public_name, profile_path(comment.user.username),
            data: { turbo_frame: "_top" }, class: "font-semibold" %>
      <span class="opacity-60"><%= time_ago_in_words(comment.created_at) %> ago</span>
    </p>
    <p class="whitespace-pre-line wrap-break-words text-sm"><%= comment.body %></p>
    <div class="mt-1 flex flex-wrap items-center gap-3 text-xs opacity-70">
      <%= render "comments/like", comment: comment %>
      <%= render "comments/stats", comment: comment %>
      <% if authenticated? && comment.deletable_by?(Current.session.user) %>
        <%= button_to "Delete", comment_path(comment), method: :delete,
              class: "link link-hover text-error",
              form: { class: "inline", data: { turbo_confirm: "Delete this comment and its replies?" } } %>
      <% end %>
    </div>
    <%= render "replies/form", target: comment %>
    <div class="mt-3">
      <%= render "replies/area", comment: comment, replies: local_assigns[:expanded_replies],
            next_cursor: local_assigns[:next_cursor] %>
    </div>
  </div>
</li>