<% content_for :title, "About" %>

<% structure = [
  [ "Topics", "The big subjects. Each topic works like a shelf that groups related ideas together." ],
  [ "Cards", "Smaller themes inside a topic. A card collects the posts that belong together." ],
  [ "Posts", "The actual writing. Every post lives inside one card, inside one topic." ]
] %>

<div class="max-w-5xl mx-auto my-8 px-4">

  <%# Hero %>
  <section class="page-hero">
    <p class="page-hero__eyebrow">About Aalam</p>
    <h1 class="page-hero__title">A small corner of the <span class="page-hero__accent">world</span></h1>
    <p class="page-hero__text">
      Aalam means world. This is a personal blog where I write down what I learn, build and think about.
      Everything here is my own views and opinions.
    </p>
  </section>

  <%# How the site is organised %>
  <div class="section-heading">
    <h2 class="section-heading__title">How Aalam is organised</h2>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <% structure.each_with_index do |(title, text), index| %>
      <div class="surface-panel">
        <div class="surface-panel__body space-y-2">
          <span class="badge badge-primary badge-sm"><%= index + 1 %></span>
          <h3 class="text-lg font-semibold"><%= title %></h3>
          <p class="text-sm text-base-content/70"><%= text %></p>
        </div>
      </div>
    <% end %>
  </div>

  <%# About the author %>
  <div class="section-heading">
    <h2 class="section-heading__title">About the author</h2>
  </div>

  <div class="surface-panel">
    <div class="surface-panel__body space-y-3">
      <p>
        Write a short introduction about yourself here: who you are, what you study or build,
        and why you started this blog.
      </p>
      <p class="text-base-content/70">
        A second paragraph is a good place for your interests and what readers can expect to find here.
      </p>
    </div>
  </div>

  <div class="mt-10 flex flex-wrap gap-3">
    <%= link_to "Explore topics", explore_path, class: "btn btn-primary" %>
    <%= link_to "Get in touch", contact_path, class: "btn btn-ghost" %>
  </div>
</div>