<div class="mt-12">
  <h1 class="font-bold text-4xl bg-gray-200 w-48 flex justify-center rounded-md"><%= @card.title %></h1>

  <% @posts.each do |post| %>
    <article class="flex flex-col m-4 border-b p-4">
      <h2 class="font-bold text-red-400 text-5xl"><%= post.title %></h2>
      <%= link_to "Read Post", post_show_path(post),
          class: "btn btn-primary w-64" %>
    </article>
  <% end %>
</div>