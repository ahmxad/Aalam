<div class="text-sm text-gray-500 mt-6 mb-6">
  <%= @card.topic.title %> /
  <%= @card.title %>
</div>
<div class="mt-12">
  <h1 class="font-bold text-4xl bg-gray-200 w-full flex justify-center rounded-md">
    <%= @card.title %>
  </h1>
  <p class="text-sm text-base-content/60 mt-2 mb-6">
    Card created at: <%= @card.created_at.strftime("%d %b %Y") %>
  </p>
  <% @posts.each do |post| %>
    <article class="flex flex-col m-4 border-b p-4">
      <h2 class="font-bold text-red-400 text-5xl"><%= post.title %></h2>
      <%= link_to "Read Post", topic_card_post_path(@topic.slug, @card.slug, post.slug), class: "btn btn-primary w-64" %>
    </article>
  <% end %>
</div>