<% content_for :title, @query.present? ? "Search: #{@query}" : "Search" %>
<div class="max-w-4xl mx-auto px-4 py-10">
  <h1 class="text-3xl font-bold mb-6">Search Results</h1>
  <% if @query.blank? %>
    <p>Please enter something to search.</p>
  <% else %>
    <% topics = @topics || [] %>
    <% cards = @cards || [] %>
    <% posts = @posts || [] %>
    <% total = topics.size + cards.size + posts.size %>
    <p class="mb-2 text-base-content/70">
      Found <%= total %> result(s) for
      "<%= @query %>"
    </p>
    <% if total.zero? %>
      <p>No results found.</p>
    <% end %>
    <% if topics.any? %>
      <div class="section-heading">
        <h2 class="section-heading__title">Topics</h2>
        <span class="badge badge-primary badge-sm"><%= topics.size %></span>
      </div>
      <% if topics.size >= @search_limit %>
        <p class="mb-3 text-sm text-base-content/60">
          Showing the first <%= @search_limit %> results. Try a more specific search to narrow them down.
        </p>
      <% end %>
      <div class="space-y-4">
        <% topics.each do |topic| %>
          <article class="surface-row">
            <div class="min-w-0">
              <h3 class="surface-row__title"><%= topic.title %></h3>
            </div>
            <div class="shrink-0">
              <%= link_to "View Topic", topic_path(topic.slug), class: "btn btn-primary btn-sm" %>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>
    <% if cards.any? %>
      <div class="section-heading">
        <h2 class="section-heading__title">Cards</h2>
        <span class="badge badge-primary badge-sm"><%= cards.size %></span>
      </div>
      <% if cards.size >= @search_limit %>
        <p class="mb-3 text-sm text-base-content/60">
          Showing the first <%= @search_limit %> results. Try a more specific search to narrow them down.
        </p>
      <% end %>
      <div class="space-y-4">
        <% cards.each do |card| %>
          <article class="surface-row">
            <div class="min-w-0">
              <p class="surface-row__meta mt-0!">
                Topic:
                <%= link_to card.topic.title, topic_path(card.topic.slug), class: "text-primary hover:underline" %>
              </p>
              <h3 class="surface-row__title"><%= card.title %></h3>
            </div>
            <div class="shrink-0">
              <%= link_to "View Card", topic_card_path(card.topic.slug, card.slug), class: "btn btn-primary btn-sm" %>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>
    <% if posts.any? %>
      <div class="section-heading">
        <h2 class="section-heading__title">Posts</h2>
        <span class="badge badge-primary badge-sm"><%= posts.size %></span>
      </div>
      <% if posts.size >= @search_limit %>
        <p class="mb-3 text-sm text-base-content/60">
          Showing the first <%= @search_limit %> results. Try a more specific search to narrow them down.
        </p>
      <% end %>
      <div class="space-y-4">
        <% posts.each do |post| %>
          <article class="surface-row">
            <div class="min-w-0">
              <div class="trail">
                <%= link_to post.card.topic.title, topic_path(post.card.topic.slug), class: "trail__item trail__item--primary" %>
                <span class="trail__sep" aria-hidden="true">›</span>
                <%= link_to post.card.title, topic_card_path(post.card.topic.slug, post.card.slug), class: "trail__item" %>
              </div>
              <h3 class="surface-row__title"><%= post.title %></h3>
              <p class="surface-row__text"><%= truncate(post.summary, length: 200) %></p>
            </div>
            <div class="shrink-0">
              <%= link_to "Read Post",
                    topic_card_post_path(post.card.topic.slug, post.card.slug, post.slug),
                    class: "btn btn-primary btn-sm" %>
            </div>
          </article>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>