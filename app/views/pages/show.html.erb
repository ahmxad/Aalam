<% content_for :title, "#{@post.title} · #{@card.title}" %>
<% word_count = @post.body.to_s.split.size %>
<% reading_minutes = [ (word_count / 200.0).ceil, 1 ].max %>
<div class="max-w-3xl mx-auto my-8 px-4">
  <%# Breadcrumb %>
  <div class="breadcrumbs text-sm mb-6">
    <ul>
      <li><%= link_to @topic.title, topic_path(@topic.slug) %></li>
      <li><%= link_to @card.title, topic_card_path(@topic.slug, @card.slug) %></li>
      <li class="truncate max-w-48"><%= @post.title %></li>
    </ul>
  </div>
  <article>
    <%# Header %>
    <header class="mb-8" data-controller="reveal" data-reveal-trigger-value="load">
      <p class="text-xs font-semibold uppercase tracking-wide text-primary" data-reveal-item>
        <%= link_to @card.title, topic_card_path(@topic.slug, @card.slug) %>
      </p>
      <h1 class="article-title" data-reveal-item><%= @post.title %></h1>
      <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-base-content/60" data-reveal-item>
        <span><%= @post.created_at.strftime("%d %b %Y") %></span>
        <span class="badge badge-primary badge-sm"><%= reading_minutes %> min read</span>
      </div>
      <% if @post.summary.present? %>
        <p class="article-lead" data-reveal-item><%= @post.summary %></p>
      <% end %>
    </header>
    <%# Body: keep this on one line, line breaks inside would show as blank lines %>
    <div class="article-body" data-controller="code-copy"><%= render_markdown(@post.body, images: @post.images) %></div>
  </article>
  <div data-controller="comments-modal">
    <%= render "shared/post_actions", post: @post %>
    <%# The comments window, opened by the Comments button above %>
    <dialog class="modal modal-bottom sm:modal-middle" aria-label="Comments" data-lenis-prevent
            data-comments-modal-target="dialog"
            data-action="click->comments-modal#closeOnBackdrop wheel->comments-modal#keepScrollInside:passive touchmove->comments-modal#keepScrollInside:passive">
      <div class="modal-box flex h-[80vh] max-h-[80vh] w-full flex-col overflow-hidden p-0 sm:max-w-lg">
        <%= turbo_frame_tag "comments_panel", class: "flex min-h-0 flex-1 flex-col" do %>
          <p class="p-6 text-sm opacity-70">Loading comments...</p>
        <% end %>
      </div>
    </dialog>
  </div>
  <%# Previous / next %>
  <% if @previous_post || @next_post %>
    <div class="section-heading">
      <h2 class="section-heading__title">Keep reading</h2>
    </div>
    <nav aria-label="More posts in this card" class="grid grid-cols-1 gap-4 sm:grid-cols-2" data-controller="reveal">
      <% if @previous_post %>
        <%= link_to topic_card_post_path(@topic.slug, @card.slug, @previous_post.slug), class: "surface-card", data: { reveal_item: true } do %>
          <div class="surface-card__body">
            <p class="surface-card__meta">&larr; Previous</p>
            <h3 class="surface-card__title"><%= @previous_post.title %></h3>
          </div>
        <% end %>
      <% else %>
        <div></div>
      <% end %>
      <% if @next_post %>
        <%= link_to topic_card_post_path(@topic.slug, @card.slug, @next_post.slug), class: "surface-card text-right", data: { reveal_item: true } do %>
          <div class="surface-card__body">
            <p class="surface-card__meta">Next &rarr;</p>
            <h3 class="surface-card__title"><%= @next_post.title %></h3>
          </div>
        <% end %>
      <% end %>
    </nav>
  <% end %>
  <div class="mt-8">
    <%= link_to "← Back to #{@card.title}", topic_card_path(@topic.slug, @card.slug), class: "btn btn-ghost btn-sm" %>
  </div>
</div>