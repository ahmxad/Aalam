<% content_for :title, "#{@post.title} · #{@card.title}" %>
<% word_count = @post.body.to_s.split.size %>
<% reading_minutes = [ (word_count / 200.0).ceil, 1 ].max %>
<div class="max-w-3xl mx-auto my-8 px-4">
  <%# Breadcrumb %>
  <div class="breadcrumbs text-sm mb-6">
    <ul>
      <li><%= link_to @topic.title, topic_path(@topic.slug) %></li>
      <li><%= link_to @card.title, topic_card_path(@topic.slug, @card.slug) %></li>
      <li class="truncate max-w-48"><%= @post.title %></li>
    </ul>
  </div>
  <article>
    <%# Header %>
    <header class="mb-8">
      <p class="text-xs font-semibold uppercase tracking-wide text-primary">
        <%= link_to @card.title, topic_card_path(@topic.slug, @card.slug) %>
      </p>
      <h1 class="mt-2 text-3xl sm:text-5xl font-bold leading-tight"><%= @post.title %></h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-base-content/60">
        <span><%= @post.created_at.strftime("%d %b %Y") %></span>
        <span aria-hidden="true">·</span>
        <span><%= reading_minutes %> min read</span>
      </div>
      <% if @post.summary.present? %>
        <p class="mt-6 border-l-4 border-primary pl-4 text-lg text-base-content/70 italic">
          <%= @post.summary %>
        </p>
      <% end %>
    </header>
    <%# Body %>
    <div class="whitespace-pre-line text-lg leading-relaxed text-base-content">
      <%= @post.body %>
    </div>
  </article>
  <%# Previous / next %>
  <nav aria-label="More posts in this card" class="mt-12 grid grid-cols-1 gap-4 border-t border-base-300 pt-8 sm:grid-cols-2">
    <% if @previous_post %>
      <%= link_to topic_card_post_path(@topic.slug, @card.slug, @previous_post.slug),
            class: "group rounded-box border border-base-200 bg-base-100 p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md" do %>
        <span class="text-xs uppercase tracking-wide text-base-content/50">&larr; Previous</span>
        <span class="mt-1 block font-semibold group-hover:text-primary transition-colors"><%= @previous_post.title %></span>
      <% end %>
    <% else %>
      <div></div>
    <% end %>
    <% if @next_post %>
      <%= link_to topic_card_post_path(@topic.slug, @card.slug, @next_post.slug),
            class: "group rounded-box border border-base-200 bg-base-100 p-4 text-right shadow-sm transition hover:-translate-y-0.5 hover:shadow-md" do %>
        <span class="text-xs uppercase tracking-wide text-base-content/50">Next &rarr;</span>
        <span class="mt-1 block font-semibold group-hover:text-primary transition-colors"><%= @next_post.title %></span>
      <% end %>
    <% end %>
  </nav>
  <div class="mt-8">
    <%= link_to "← Back to #{@card.title}", topic_card_path(@topic.slug, @card.slug), class: "btn btn-ghost btn-sm" %>
  </div>
</div>