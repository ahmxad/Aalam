<% content_for :title, @topic.title %>
<div class="max-w-5xl mx-auto my-8 px-4">
  <%# Breadcrumb %>
  <div class="breadcrumbs text-sm mb-4">
    <ul>
      <li><%= link_to "Explore", explore_path %></li>
      <li><%= @topic.title %></li>
    </ul>
  </div>
  <%# Hero header %>
  <header class="surface-hero" data-controller="reveal" data-reveal-trigger-value="load">
    <% if @topic.image.attached? %>
      <%= image_tag @topic.image.variant(:hero), alt: "", class: "surface-hero__media" %>
    <% end %>
    <div class="surface-hero__overlay"></div>
    <div class="surface-hero__content">
      <h1 class="surface-hero__title" data-reveal-item><%= @topic.title %></h1>
      <div class="flex flex-wrap items-center gap-3 mt-3" data-reveal-item>
        <span class="badge badge-primary"><%= pluralize(@cards.size, "card") %></span>
        <span class="text-sm text-base-content/70">
          Created <%= @topic.created_at.strftime("%d %b %Y") %>
        </span>
      </div>
    </div>
  </header>
  <%# Cards section %>
  <div class="section-heading">
    <h2 class="section-heading__title">Cards</h2>
  </div>
  <% if @cards.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" data-controller="reveal">
      <% @cards.each do |card| %>
        <%= link_to topic_card_path(@topic.slug, card.slug), class: "surface-card", data: { reveal_item: true } do %>
          <% if card.image.attached? %>
            <%= image_tag card.image.variant(:card), alt: card.title, class: "surface-card__media" %>
          <% else %>
            <div class="surface-card__placeholder"></div>
          <% end %>
          <div class="surface-card__body">
            <h2 class="surface-card__title"><%= card.title %></h2>
            <p class="surface-card__meta"><%= pluralize(card.posts.size, "post") %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 text-base-content/60">
      <p>No cards in this topic yet.</p>
    </div>
  <% end %>
  <div class="mt-10">
    <%= link_to "← Back to Explore", explore_path, class: "btn btn-ghost btn-sm" %>
  </div>
</div>