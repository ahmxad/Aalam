<% content_for :title, @topic.title %>
<div class="max-w-5xl mx-auto my-8 px-4">
  <%# Breadcrumb %>
  <div class="breadcrumbs text-sm mb-4">
    <ul>
      <li><%= link_to "Explore", explore_path %></li>
      <li><%= @topic.title %></li>
    </ul>
  </div>
  <%# Header %>
  <header class="card bg-base-100 border border-base-200 shadow-md overflow-hidden mb-10">
    <% if @topic.image.attached? %>
      <figure>
        <%= image_tag @topic.image.variant(:card), alt: @topic.title, class: "w-full h-48 sm:h-64 object-cover" %>
      </figure>
    <% end %>
    <div class="card-body">
      <h1 class="text-3xl sm:text-4xl font-bold"><%= @topic.title %></h1>
      <div class="flex flex-wrap items-center gap-2 mt-1">
        <span class="badge badge-ghost"><%= pluralize(@cards.size, "card") %></span>
        <span class="text-sm text-base-content/60">
          Created <%= @topic.created_at.strftime("%d %b %Y") %>
        </span>
      </div>
    </div>
  </header>
  <%# Cards %>
  <% if @cards.any? %>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @cards.each do |card| %>
        <%= link_to topic_card_path(@topic.slug, card.slug),
              class: "group block transition hover:-translate-y-1" do %>
          <div class="card card-sm bg-base-100 shadow-md border border-base-200 overflow-hidden h-full">
            <% if card.image.attached? %>
              <%= image_tag card.image.variant(:card), alt: card.title, class: "w-full h-40 object-cover" %>
            <% else %>
              <div class="w-full h-40 bg-base-200"></div>
            <% end %>
            <div class="card-body">
              <h2 class="card-title text-base font-semibold group-hover:text-primary transition-colors">
                <%= card.title %>
              </h2>
              <p class="text-sm text-base-content/60">
                <%= pluralize(card.posts.size, "post") %>
              </p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-16 text-base-content/60">
      <p>No cards in this topic yet.</p>
    </div>
  <% end %>
  <div class="mt-10">
    <%= link_to "← Back to Explore", explore_path, class: "btn btn-ghost btn-sm" %>
  </div>
</div>