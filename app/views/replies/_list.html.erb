<ul class="space-y-3">
  <%= render partial: "replies/reply", collection: replies, as: :reply %>
</ul>
<% if next_cursor %>
  <%= turbo_frame_tag "replies_more_#{comment.id}_#{next_cursor}", class: "mt-3 block" do %>
    <%= link_to "View more replies", comment_replies_path(comment, cursor: next_cursor),
          class: "link link-hover text-xs" %>
  <% end %>
<% end %>