<% content_for :title, "Log in | Aalam" %>
<section class="mx-auto w-full max-w-md py-10">
  <h1 class="mb-6 text-2xl font-bold">Log in</h1>
  <%= form_with url: session_path, class: "flex flex-col gap-4" do |f| %>
    <%= f.text_field :login, required: true, autofocus: true, autocomplete: "username",
          autocapitalize: "none", spellcheck: false,
          placeholder: "Username or email address", "aria-label": "Username or email address",
          class: "input input-bordered w-full" %>
    <%= f.password_field :password, required: true, autocomplete: "current-password",
          placeholder: "Password", "aria-label": "Password",
          class: "input input-bordered w-full" %>
    <%= f.submit "Log in", class: "btn btn-primary" %>
  <% end %>
  <%= render "shared/social_login" %>
  <div class="mt-4 flex flex-col gap-1 text-sm">
    <p>No account? <%= link_to "Create one", signup_path, class: "link" %></p>
    <p><%= link_to "Forgot your password?", new_password_path, class: "link" %></p>
  </div>
</section>