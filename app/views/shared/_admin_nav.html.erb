<%
  admin_links = [
    [ "Dashboard", admin_root_path, "admin/dashboard" ],
    [ "Topics", admin_topics_path, "admin/topics" ],
    [ "Cards", admin_cards_path, "admin/cards" ],
    [ "Posts", admin_posts_path, "admin/posts" ]
  ]
%>
<nav class="mt-3 flex flex-wrap items-center gap-2 rounded-md border border-base-300 bg-base-100 px-4 py-2">
  <span class="badge badge-neutral mr-2">Admin</span>
  <% admin_links.each do |label, path, ctrl| %>
    <%= link_to label, path, class: [ "btn btn-sm", controller_path == ctrl ? "btn-primary" : "btn-ghost" ] %>
  <% end %>
  <%= link_to "View site", root_path, class: "btn btn-sm btn-outline ml-auto" %>
</nav>