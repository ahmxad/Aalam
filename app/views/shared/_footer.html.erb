<footer class="px-3 pb-3 mt-12">
  <div class="rounded-3xl bg-white/40 backdrop-blur-md border border-white/60 shadow-sm px-6 py-8">
    <div class="grid grid-cols-1 gap-8 sm:grid-cols-3">
      <%# Brand %>
      <div>
        <%= link_to root_path, class: "inline-block" do %>
          <%= image_tag "logo.svg", alt: "Aalam logo", class: "h-10 w-auto object-contain" %>
        <% end %>
        <p class="mt-3 text-sm text-base-content/70">
          A personal blog. Everything here is my own views and opinions.
        </p>
      </div>
      <%# Quick links %>
      <nav aria-label="Footer links">
        <h6 class="text-xs font-semibold uppercase tracking-wide text-base-content/60 mb-3">Pages</h6>
        <ul class="space-y-2 text-sm">
          <li><%= link_to "Home", root_path, class: "hover:underline" %></li>
          <li><%= link_to "About", about_path, class: "hover:underline" %></li>
          <li><%= link_to "Explore", explore_path, class: "hover:underline" %></li>
          <li><%= link_to "Contact", contact_path, class: "hover:underline" %></li>
        </ul>
      </nav>
      <%# Social %>
      <nav aria-label="Social links">
        <h6 class="text-xs font-semibold uppercase tracking-wide text-base-content/60 mb-3">Social</h6>
        <div class="flex items-center gap-4">
          <%= link_to "#", "aria-label": "Twitter", class: "hover:opacity-70 transition-opacity" do %>
            <%= image_tag "social_logos/twitter.svg", alt: "", class: "h-6 w-6" %>
          <% end %>
          <%= link_to "#", "aria-label": "Instagram", class: "hover:opacity-70 transition-opacity" do %>
            <%= image_tag "social_logos/instagram.svg", alt: "", class: "h-6 w-6" %>
          <% end %>
          <%= link_to "#", "aria-label": "TikTok", class: "hover:opacity-70 transition-opacity" do %>
            <%= image_tag "social_logos/tiktok.svg", alt: "", class: "h-6 w-6" %>
          <% end %>
        </div>
      </nav>
    </div>
    <%# Bottom bar %>
    <div class="mt-8 border-t border-base-content/10 pt-4 flex flex-wrap items-center justify-between gap-2 text-xs text-base-content/60">
      <p>&copy; <%= Time.current.year %> Aalam. All rights reserved.</p>
      <p>Aalam means world.</p>
    </div>
  </div>
</footer>