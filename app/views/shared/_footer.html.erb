<footer class="mt-12 bg-neutral text-neutral-content border-t border-base-300">
  <div class="mx-auto flex max-w-7xl flex-col items-center gap-3 px-5 py-3 sm:flex-row sm:justify-between">
    <%# Brand and copyright %>
    <div class="flex items-center gap-3">
      <%= link_to root_path, "aria-label": "Aalam home", class: "rounded-md bg-base-content px-2 py-1" do %>
        <%= image_tag "logo.svg", alt: "Aalam logo", class: "h-6 w-auto object-contain" %>
      <% end %>
      <p class="text-xs text-neutral-content/70">
        &copy; <%= Time.current.year %> Aalam &middot; Personal blog, my own views and opinions
      </p>
    </div>
    <%# Page links %>
    <nav aria-label="Footer links">
      <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-xs">
        <li><%= link_to "Home", root_path, class: "hover:text-neutral-content hover:underline transition-colors" %></li>
        <li><%= link_to "About", about_path, class: "hover:text-neutral-content hover:underline transition-colors" %></li>
        <li><%= link_to "Explore", explore_path, class: "hover:text-neutral-content hover:underline transition-colors" %></li>
        <li><%= link_to "Contact", contact_path, class: "hover:text-neutral-content hover:underline transition-colors" %></li>
        <li><%= link_to "Report a bug", contact_path(reason: "bug"), class: "hover:text-neutral-content hover:underline transition-colors" %></li>
        <li><%= link_to "Privacy", privacy_path, class: "hover:text-neutral-content hover:underline transition-colors" %></li>
        <li><%= link_to "Terms", terms_path, class: "hover:text-neutral-content hover:underline transition-colors" %></li>
      </ul>
    </nav>
    <%# Social %>
    <nav aria-label="Social links" class="flex items-center gap-2">
      <%= link_to "#", "aria-label": "Twitter", class: "rounded-md bg-base-content p-1.5 transition hover:bg-primary" do %>
        <%= image_tag "social_logos/twitter.svg", alt: "", class: "h-4 w-4" %>
      <% end %>
      <%= link_to "#", "aria-label": "Instagram", class: "rounded-md bg-base-content p-1.5 transition hover:bg-primary" do %>
        <%= image_tag "social_logos/instagram.svg", alt: "", class: "h-4 w-4" %>
      <% end %>
      <%= link_to "#", "aria-label": "TikTok", class: "rounded-md bg-base-content p-1.5 transition hover:bg-primary" do %>
        <%= image_tag "social_logos/tiktok.svg", alt: "", class: "h-4 w-4" %>
      <% end %>
    </nav>
  </div>
</footer>