<%# Active link gets the primary color, the rest stay subtle %>
<% link_class = ->(path) { [ "btn btn-sm", current_page?(path) ? "btn-primary" : "btn-ghost" ] } %>
<% auth_page = %w[sessions registrations oauth_signups].include?(controller_name) %>
<header id="site-header" class="sticky top-0 z-50 px-3 pt-2">
  <input id="navbar-toggle" class="peer hidden" type="checkbox" />
  <%# Closes the mobile menu when clicking anywhere outside it %>
  <label for="navbar-toggle" class="fixed inset-0 hidden peer-checked:block lg:peer-checked:hidden"></label>
  <%# One single glass bar %>
  <div class="relative flex items-center gap-2 bg-base-200/70 backdrop-blur-md border border-base-300 px-2 py-1">
    <label for="navbar-toggle" aria-label="Open menu" class="btn btn-sm btn-square btn-ghost lg:hidden">
      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
      </svg>
    </label>
    <% if sidebar_visible? %>
      <button type="button" class="btn btn-sm btn-square btn-ghost"
              aria-label="Show or hide the topics menu"
              aria-controls="sidebar" aria-expanded="true"
              data-sidebar-target="toggle" data-action="sidebar#toggle">
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-width="2" d="M3 4h18v16H3z M9 4v16" />
        </svg>
      </button>
    <% end %>
    <div class="tooltip tooltip-right" data-tip="Aalam means world">
      <%= link_to root_path, class: "flex items-center px-2" do %>
        <%= image_tag "logo.svg", alt: "Aalam logo", class: "h-8 w-auto object-contain" %>
      <% end %>
    </div>
    <nav aria-label="Main" class="hidden lg:flex absolute left-1/2 -translate-x-1/2">
      <ul class="flex items-center gap-1">
        <li><%= link_to "Home", root_path, class: link_class.(root_path) %></li>
        <li><%= link_to "About", about_path, class: link_class.(about_path) %></li>
        <li><%= link_to "Explore", explore_path, class: link_class.(explore_path) %></li>
        <li><%= link_to "Contact", contact_path, class: link_class.(contact_path) %></li>
      </ul>
    </nav>
    <%= form_with url: search_path, method: :get,
          class: "join ml-auto overflow-hidden bg-base-100/70 border border-base-300" do |f| %>
      <%= f.search_field :q,
            placeholder: "Search...",
            value: params[:q].to_s.first(PagesController::MAX_QUERY_LENGTH), maxlength: PagesController::MAX_QUERY_LENGTH,
            "aria-label": "Search",
            class: "input input-sm join-item bg-transparent border-0 w-28 sm:w-44 lg:w-56 focus:outline-none" %>
      <%= f.button type: "submit", name: nil, "aria-label": "Submit search", class: "btn btn-sm btn-primary join-item" do %>
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <circle cx="11" cy="11" r="7" stroke-width="2" />
          <path stroke-linecap="round" stroke-width="2" d="m16 16 4 4" />
        </svg>
      <% end %>
    <% end %>
    <% if authenticated? %>
      <% viewer = Current.session.user %>
      <%# Profile menu: opens when the avatar button is focused, closes when focus leaves %>
      <div class="dropdown dropdown-end">
        <div tabindex="0" role="button" aria-label="Open profile menu"
             class="btn btn-sm btn-square btn-ghost p-0">
          <%= user_avatar(viewer, size_class: "w-8", letter_class: "text-sm") %>
        </div>
        <div tabindex="0" class="dropdown-content z-50 mt-2 w-56 border border-base-300 bg-base-200 shadow-sm">
          <div class="px-4 py-3">
            <p class="truncate font-semibold"><%= viewer.public_name %></p>
            <p class="truncate text-sm opacity-70">@<%= viewer.username %></p>
          </div>
          <ul class="menu w-full border-t border-base-300">
            <li><%= link_to "Profile", profile_path(viewer.username) %></li>
            <li><%= link_to "Saved posts", profile_path(viewer.username, anchor: "saved-posts") %></li>
            <li><%= link_to "Account settings", edit_account_path %></li>
          </ul>
          <div class="border-t border-base-300 p-2">
            <%= button_to "Log out", session_path, method: :delete,
                  class: "btn btn-sm btn-ghost w-full justify-start", form: { class: "w-full" } %>
          </div>
        </div>
      </div>
    <% elsif !auth_page %>
      <div class="hidden lg:flex items-center gap-1">
        <%= link_to "Log in", new_session_path, class: link_class.(new_session_path) %>
        <%= link_to "Sign up", signup_path, class: link_class.(signup_path) %>
      </div>
    <% end %>
  </div>
  <%# Mobile menu, opens below the bar %>
  <div class="relative mt-2 hidden peer-checked:block lg:hidden">
    <ul class="menu rounded-box bg-base-200/95 backdrop-blur-md border border-base-300 shadow-sm">
      <li><%= link_to "Home", root_path, class: ("menu-active" if current_page?(root_path)) %></li>
      <li><%= link_to "About", about_path, class: ("menu-active" if current_page?(about_path)) %></li>
      <li><%= link_to "Explore", explore_path, class: ("menu-active" if current_page?(explore_path)) %></li>
      <li><%= link_to "Contact", contact_path, class: ("menu-active" if current_page?(contact_path)) %></li>
      <% unless authenticated? || auth_page %>
        <li><%= link_to "Log in", new_session_path, class: ("menu-active" if current_page?(new_session_path)) %></li>
        <li><%= link_to "Sign up", signup_path, class: ("menu-active" if current_page?(signup_path)) %></li>
      <% end %>
    </ul>
  </div>
</header>