<%# Active link gets the primary color, the rest stay subtle %>
<% link_class = ->(path) { [ "btn btn-sm rounded-full", current_page?(path) ? "btn-primary" : "btn-ghost" ] } %>
<header class="sticky top-0 z-50 px-3 pt-2">
  <input id="navbar-toggle" class="peer hidden" type="checkbox" />
  <%# Closes the mobile menu when clicking anywhere outside it %>
  <label for="navbar-toggle" class="fixed inset-0 hidden peer-checked:block lg:peer-checked:hidden"></label>
  <%# One single glass bar %>
  <div class="relative flex items-center gap-2 rounded-full bg-base-200/70 backdrop-blur-md border border-base-300 px-2 py-1">
    <label for="navbar-toggle" aria-label="Open menu" class="btn btn-sm btn-circle btn-ghost lg:hidden">
      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" />
      </svg>
    </label>
    <div class="tooltip tooltip-right" data-tip="Aalam means world">
      <%= link_to root_path, class: "flex items-center px-2" do %>
        <%= image_tag "logo.svg", alt: "Aalam logo", class: "h-8 w-auto object-contain" %>
      <% end %>
    </div>
    <nav aria-label="Main" class="hidden lg:flex absolute left-1/2 -translate-x-1/2">
      <ul class="flex items-center gap-1">
        <li><%= link_to "Home", root_path, class: link_class.(root_path) %></li>
        <li><%= link_to "About", about_path, class: link_class.(about_path) %></li>
        <li><%= link_to "Explore", explore_path, class: link_class.(explore_path) %></li>
        <li><%= link_to "Contact", contact_path, class: link_class.(contact_path) %></li>
      </ul>
    </nav>
    <%= form_with url: search_path, method: :get,
          class: "join ml-auto rounded-full overflow-hidden bg-base-100/70 border border-base-300" do |f| %>
      <%= f.search_field :q,
            placeholder: "Search...",
            value: params[:q].to_s.first(PagesController::MAX_QUERY_LENGTH), maxlength: PagesController::MAX_QUERY_LENGTH,
            "aria-label": "Search",
            class: "input input-sm join-item bg-transparent border-0 w-28 sm:w-44 lg:w-56 focus:outline-none" %>
      <%= f.button type: "submit", name: nil, "aria-label": "Submit search", class: "btn btn-sm btn-primary join-item" do %>
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <circle cx="11" cy="11" r="7" stroke-width="2" />
          <path stroke-linecap="round" stroke-width="2" d="m16 16 4 4" />
        </svg>
      <% end %>
    <% end %>
  </div>
  <%# Mobile menu, opens below the bar %>
  <div class="relative mt-2 hidden peer-checked:block lg:hidden">
    <ul class="menu rounded-box bg-base-200/95 backdrop-blur-md border border-base-300 shadow-sm">
      <li><%= link_to "Home", root_path, class: ("menu-active" if current_page?(root_path)) %></li>
      <li><%= link_to "About", about_path, class: ("menu-active" if current_page?(about_path)) %></li>
      <li><%= link_to "Explore", explore_path, class: ("menu-active" if current_page?(explore_path)) %></li>
      <li><%= link_to "Contact", contact_path, class: ("menu-active" if current_page?(contact_path)) %></li>
    </ul>
  </div>
</header>