<div class="max-lg:collapse bg-base-200 shadow-sm w-full rounded-md">
  <input id="navbar-1-toggle" class="peer hidden" type="checkbox" />
  <label for="navbar-1-toggle" class="fixed inset-0 hidden max-lg:peer-checked:block"></label>
  <div class="collapse-title navbar">
    <div class="navbar-start">
      <label for="navbar-1-toggle" class="btn btn-ghost lg:hidden">
        <svg aria-label="Menu" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16" /></svg>
      </label>
    <div class="tooltip tooltip-right" data-tip="Aalam means world">
        <%= image_tag 'logo.svg', alt: 'Website Logo', class: 'h-20 w-auto object-contain pl-4 cursor-pointer' %>
    </div>

    </div>
    <div class="navbar-center hidden lg:flex">
      <ul class="menu menu-horizontal px-1">
        <li><%= link_to "Home", root_path %></li>
        <li><%= link_to "About", about_path %></li>
        <li><%= link_to "Explore", explore_path %></li>
        <li><%= link_to "Contact", contact_path %></li>
      </ul>
    </div>
<div class="navbar-end">
  <%= form_with url: search_path, method: :get, class: "flex items-center gap-2" do |f| %>
    <%= f.search_field :q,
        placeholder: "Search...",
        value: params[:q],
        class: "input w-36 sm:w-48 lg:w-64" %>

    <%= f.button type: "submit", name: nil,
    class: "btn btn-primary" do %>
  <svg xmlns="http://www.w3.org/2000/svg"
       class="h-5 w-5"
       fill="none"
       viewBox="0 0 24 24"
       stroke="currentColor">
    <circle cx="11" cy="11" r="7" stroke-width="2" />
    <path stroke-linecap="round" stroke-width="2" d="m16 16 4 4" />
  </svg>
<% end %>
  <% end %>
</div>
  </div>

  <div class="collapse-content lg:hidden z-1">
    <ul class="menu">
      <li><%= link_to "Home", root_path %></li>
      <li><%= link_to "About", about_path %></li>
      <li><%= link_to "Explore", explore_path %></li>
      <li><%= link_to "Contact", contact_path %></li>
    </ul>
  </div>
</div>